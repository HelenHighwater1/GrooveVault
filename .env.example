# Local dev uses the Clerk *development* instance — required for the e2e
# suite's +clerk_test emails and 424242 OTP. Keys must stay paired
# (pk_test_ with sk_test_, pk_live_ with sk_live_).
# The deployed app on Fly uses the *production* instance instead:
# pk_live_ goes in fly.toml [build.args], sk_live_ via `flyctl secrets set`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/collection
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/collection

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Personal access token from https://www.discogs.com/settings/developers
DISCOGS_TOKEN=xxx

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx
SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx
# Build-time secret for source map uploads
# SENTRY_AUTH_TOKEN=
